# -----------------------------
# Core model + Azure OpenAI
# -----------------------------
AZURE_OPENAI_ENDPOINT=https://YOUR-AZURE-RESOURCE.openai.azure.com/
AZURE_OPENAI_API_KEY=YOUR_AZURE_OPENAI_API_KEY
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_MODEL=gpt-4o-mini
LLM_MODEL=gpt-4o-mini
ROUTER_MODEL=gpt-4o-mini
MCP_PLANNER_MODEL=gpt-4o-mini

# -----------------------------
# Best-practices external tool
# -----------------------------
OPENWEBUI_URL=http://tools.eu-central-1.elasticbeanstalk.com/api/chat/completions
OPENWEBUI_API_TOKEN=reberr
OPENWEBUI_BESTPRACTICES_MODEL=bp-gpt
OPENWEBUI_TIMEOUT_SECONDS=20

# -----------------------------
# Web search (optional)
# -----------------------------
TAVILY_API_KEY=
TAVILY_MAX_RESULTS=5

# -----------------------------
# Auth / internal calls
# -----------------------------
CHAINLIT_INTERNAL_API_TOKEN=CHANGE_ME_INTERNAL_TOKEN
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:8000
CSRF_TRUSTED_ORIGINS=http://localhost:8000

# -----------------------------
# RDS PostgreSQL URLs
# IMPORTANT:
# - DATABASE_URL is used by Django (sync driver).
# - CHAINLIT_DATABASE_URL is used by SQLAlchemy async data layer.
# -----------------------------
DATABASE_URL=postgresql://APP_USER:APP_PASSWORD@YOUR-RDS-ENDPOINT:5432/ragtool
CHAINLIT_DATABASE_URL=postgresql+asyncpg://APP_USER:APP_PASSWORD@YOUR-RDS-ENDPOINT:5432/ragtool

# Optional SSL toggle for Django's DB parser.
DATABASE_SSL_REQUIRE=True

# -----------------------------
# Runtime tuning
# -----------------------------
MCP_CLIENT_TIMEOUT_SECONDS=15
CHAINLIT_AGENT_HISTORY_WINDOW=15
